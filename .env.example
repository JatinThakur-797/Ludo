# =============================================================================
# Ludo Multiplayer — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is listed in .gitignore.
#
# Deployment Stack:
#   Backend  → Koyeb        (https://www.koyeb.com)
#   Database → Neon         (https://neon.tech)
#   Cache    → Upstash      (https://upstash.com)
#   Frontend → Vercel       (https://vercel.com)
# =============================================================================

# ── PostgreSQL (Neon — free serverless PostgreSQL) ───────────────────────────
# Get from: https://console.neon.tech → your project → Connection Details
# Format:  jdbc:postgresql://<host>/<dbname>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=your_neon_user
SPRING_DATASOURCE_PASSWORD=your_neon_password

# ── Redis (Upstash — free 10,000 req/day) ────────────────────────────────────
# Get from: https://console.upstash.com → your database → Connect → Redis URL
# Format:  rediss://default:<password>@<host>:<port>  (note: rediss:// for TLS)
REDIS_URL=rediss://default:your_upstash_password@your-host.upstash.io:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure 256-bit secret with:
#   openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# ── Spring Boot ───────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── CORS (set after you get your Vercel frontend URL) ────────────────────────
# Example: https://ludo-game-xxxx.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Local Docker Compose only ─────────────────────────────────────────────────
# These are only used when running docker compose up locally.
# Koyeb/Neon replace these in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Jatin@999

# ── Frontend (Vercel) ────────────────────────────────────────────────────────
# Set these in Vercel dashboard > Project Settings > Environment Variables
# VITE_API_BASE_URL=https://ludo-backend-xxxx.koyeb.app/api/v1
# VITE_WS_BASE_URL=wss://ludo-backend-xxxx.koyeb.app
